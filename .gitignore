# dependências
node_modules/

# build
.next/
dist/
out/
apps/backend/preview/
# Propostas geradas e o contador de numeracao sao dados de execucao
apps/backend/propostas/
apps/backend/Proposta_*.pdf
apps/backend/*.png
apps/frontend/scripts/screenshots/
*.tsbuildinfo

# Gerado pelo Next a cada build, e com conteudo diferente em dev e em
# producao (`.next/dev/types` contra `.next/types`). Versionado, ele ficava
# sujo no servidor e fazia o `git pull` ABORTAR com codigo de saida 0: nada
# era atualizado e o deploy nao acontecia, sem nenhum aviso. O proprio
# arquivo diz "should not be edited", e o Next o recria sozinho.
apps/frontend/next-env.d.ts

# ------------------------------------------------------------------ segredos
# Credenciais: SMTP, token do tunnel, chaves de API. Nunca versionar.
# O padrao cobre qualquer sufixo (.env.local, .env.bak-pre-tunnel, .env.old):
# um backup do .env carrega exatamente os mesmos segredos que o original.
.env
.env*
!.env.example
# Configuração de produção que não é segredo (endereço do servidor de e-mail,
# destinatários). Versionada de propósito: sem isso um `git pull` no servidor
# trazia código novo e deixava configuração velha, e os leads paravam de
# chegar sem aviso. Senha e chave de API continuam fora, no .env.
!.env.producao
*.pem
*.key
credentials.json

# Design system de referencia: 1,8 MB de HTML exportado, que nada no projeto
# importa. Versionado, respondia sozinho por 82% da barra de linguagens do
# GitHub e fazia o repositorio parecer um projeto HTML. Fica no disco de quem
# trabalha nele; os tokens que importam ja vivem em src/styles/tokens.css.
hclean-designsystem.html

