# URL da API que recebe o formulário de contato.
# Em produção, aponte para o domínio onde o apps/backend está publicado.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --------------------------------------------------------------- medição
# Container do Google Tag Manager. É ele que distribui os eventos para GA4,
# Meta, Brevo e o que mais for ligado no painel — o código não fala com
# nenhuma dessas ferramentas diretamente.
#
# Vazio: nenhum script de medição carrega e o site funciona igual.
NEXT_PUBLIC_GTM_ID=

# Domínio próprio para servir o GTM (Stape ou outro server-side).
# Faz os cookies serem de primeira parte e escapa dos bloqueadores que barram
# googletagmanager.com pelo nome. Vazio usa o domínio do Google.
#   exemplo: https://sgtm.hcleanoil.com.br
NEXT_PUBLIC_GTM_HOST=
