# Copie para .env e preencha. O .env não vai para o repositório.
#
#   cp .env.example .env

# ----------------------------------------------------------------- servidor
PORT=4000
NODE_ENV=development

# --------------------------------------------------------------------- SMTP
# Gmail exige uma SENHA DE APP, não a senha da conta:
#   myaccount.google.com/apppasswords
# São 16 caracteres; cole sem espaços.
#
# Porta 587 usa STARTTLS (recomendado). A 465 usa TLS implícito — o código
# detecta pela porta, não precisa de outra variável.
SMTP_HOST=smtp.gmail.com

# Nome a validar no certificado TLS, quando difere de SMTP_HOST. Use quando o
# hostname do servidor estiver atras de um proxy que nao encaminha SMTP e a
# conexao precisar ir por outro endereco. Vazio = valida o proprio SMTP_HOST.
SMTP_SERVERNAME=
SMTP_PORT=587
# true = TLS implicito (465); false = STARTTLS (587).
# NAO deixe vazio: string vazia e rejeitada na validacao. Para seguir a porta,
# comente ou remova a linha.
# SMTP_SECURE=
SMTP_USER=contato@exemplo.com.br
SMTP_PASS=

# ------------------------------------------------------- remetente e destino
# MAIL_FROM precisa ser um endereço que o servidor SMTP autorize a enviar —
# no Gmail, o mesmo de SMTP_USER.
MAIL_FROM=contato@exemplo.com.br
MAIL_FROM_NAME=HCLEAN

# Caixa que recebe os pedidos de orçamento do site.
MAIL_TO=contato@exemplo.com.br

# Cópia oculta de tudo que sai: notificação, confirmação e proposta.
# Oculta de verdade — quem recebe a confirmação não vê este endereço.
# Deixe vazio para desligar.
MAIL_BCC=

# Envia também uma confirmação para quem preencheu o formulário.
SEND_CONFIRMATION=true

# ------------------------------------------------------ proposta automática
# Gera a proposta em PDF e envia logo após a confirmação.
#
# Quando o pedido tem item sem preço de tabela — hoje só o Tanque Terrestre —
# a proposta vai apenas para MAIL_TO, com alerta em vermelho, para a equipe
# completar os valores antes de encaminhar ao cliente.
ENVIAR_PROPOSTA=true

# Número da última proposta emitida manualmente, para a numeração automática
# continuar de onde parou em vez de recomeçar do 1.
PROPOSTA_INICIAL=80

# Atraso do envio da proposta, em segundos (sorteado nesta janela a cada
# pedido). A proposta fica pronta em segundos, e uma cotação instantânea
# denuncia que ninguém olhou o pedido. Zere os dois para enviar na hora.
PROPOSTA_ATRASO_MIN_S=300
PROPOSTA_ATRASO_MAX_S=600

# Prazo exibido nas condições da proposta.
PRAZO_ENTREGA=15 dias úteis

# Onde guardar o contador de numeração.
PROPOSTAS_DIR=propostas

# ------------------------------------------------------------------ medição
# Container de medição server-side (Stape, GTM server-side). O backend manda o
# lead direto, porque o evento do navegador não chega quando um bloqueador
# barra o script. O mesmo lead_id viaja nos dois caminhos e o container
# deduplica.
#
# Precisa ser um endpoint seu: os dados vão em claro, e é o container que
# aplica o hash antes de repassar a Meta ou Google.
#
# Vazio desliga o envio; o formulário segue funcionando.
SGTM_URL=
SGTM_API_KEY=

# --------------------------------------------------------------------- CORS
# Origens autorizadas a chamar a API, separadas por vírgula.
# Em produção, deixe só o domínio do site.
CORS_ORIGINS=http://localhost:3000,https://www.exemplo.com.br

# --------------------------------------------------- desenvolvimento sem SMTP
# Para testar o formulário sem credenciais reais, suba o capturador local
# (`npm run maildev`) e troque as quatro linhas de SMTP por:
#
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=2525
#   SMTP_USER=dev
#   SMTP_PASS=dev
#
# As mensagens ficam em http://localhost:8025 e nada sai para a internet.
