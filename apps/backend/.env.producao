# Configuração de produção que NÃO é segredo.
#
# Este arquivo é versionado de propósito: um `git pull` no servidor precisa
# trazer junto o endereço do servidor de e-mail e para quem vão as cópias dos
# leads. Antes isso vivia só no `.env`, que é ignorado pelo git — o código novo
# subia e a configuração antiga ficava, e ninguém notava até os leads pararem
# de chegar.
#
# Senha de SMTP, chaves de API e tokens continuam FORA daqui: ficam no `.env`,
# que não é versionado. O repositório é público.
#
# Este arquivo vence o `.env`, porque é ele que viaja no `git pull` e precisa
# conseguir corrigir configuração antiga que ficou no servidor.
#
# Mas a VARIÁVEL DE AMBIENTE vence os dois. É o que permite testar sem risco:
# `MAIL_TO=caixa-de-teste npm start` manda para a caixa de teste, não para a
# do cliente.

# ----------------------------------------------------------------- servidor
PORT=4000
NODE_ENV=production

# --------------------------------------------------------------------- SMTP
# `mail.hcleanoil.com.br`, e não a raiz do domínio: a raiz é o túnel do site,
# que só carrega HTTP. Apontar o SMTP para lá foi o que deixou o formulário
# devolvendo 502 e perdendo lead. Este nome resolve direto para o servidor de
# e-mail, sem o proxy da Cloudflare.
SMTP_HOST=mail.hcleanoil.com.br
SMTP_SERVERNAME=mail.hcleanoil.com.br
# Alternativas do MESMO servidor, tentadas em ordem se a de cima falhar.
#
# Existe porque o envio ficou fora por DNS: o SMTP_HOST da VPS apontava para
# o alvo do MX (contorno de quando o apelido estava atrás do proxy da
# Cloudflare), esse nome virou NXDOMAIN, e o formulário passou a aceitar lead
# sem mandar e-mail. Um nome só é ponto único de falha numa zona que terceiros
# editam.
#
# O IP literal fecha a lista porque é o único que não depende de DNS algum.
# Ele é seguro aqui por dois motivos: é endereço de servidor, não segredo, e o
# certificado continua conferido contra SMTP_SERVERNAME — se o IP um dia for
# de outra pessoa, o TLS recusa a conexão antes de a senha viajar.
SMTP_HOST_ALTERNATIVOS=45.148.96.63
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@hcleanoil.com.br
# SMTP_PASS fica no .env.

# ------------------------------------------------------------ remetente
MAIL_FROM=contato@hcleanoil.com.br
MAIL_FROM_NAME=HCLEAN

# ---------------------------------------------------------- destinatários
# Caixa que recebe os leads do formulário.
MAIL_TO=contato@hcleanoil.com.br

# Cópia oculta de tudo que sai (notificação, confirmação e proposta).
# Aceita mais de um endereço separados por vírgula. Oculta: quem recebe a
# confirmação não enxerga estes endereços.
MAIL_BCC=contato.hcleanoil@gmail.com,mariath.dev@outlook.com

# ---------------------------------------------------------------- envios
SEND_CONFIRMATION=true
ENVIAR_PROPOSTA=true
